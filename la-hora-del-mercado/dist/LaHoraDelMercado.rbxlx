        <Item class="ModuleScript" referent="RBX10">
          <Properties>
            <string name="Name">Corre</string>
            <ProtectedString name="Source">--!strict
-- CORRE. "No corras."
-- Cada partida marca algunos pasillos con sellos invisibles. Si un jugador
-- los atraviesa corriendo, muere al instante. Las únicas pistas son un
-- brillo casi imperceptible en el piso y un susurro al acercarse.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local SoundUtil = require(ReplicatedStorage.Shared.SoundUtil)
local PlayerSession = require(script.Parent.Parent.PlayerSession)

local Corre = {}

local rng = Random.new()
local map: any
local folder: Folder? = nil
local activeSeals: { { region: any, part: Part } } = {}
local running = false

function Corre.init(builtMap: any)
	map = builtMap
end

function Corre.setup()
	Corre.cleanup()

	folder = Instance.new("Folder")
	folder.Name = "Seals"
	folder.Parent = map.model

	-- Elige pasillos sellados al azar (distintos en cada partida).
	local pool = table.clone(map.sealCandidates)
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end

	for i = 1, math.min(Config.Corre.SealCount, #pool) do
		local candidate = pool[i]
		local region = candidate.region
		local center = map.regionCenter(region)
		local sizeX = region.x1 - region.x0
		local sizeZ = region.z1 - region.z0

		-- Marca sutil en el piso: una veladura rojiza casi invisible.
		local mark = Instance.new("Part")
		mark.Name = "CorreSeal"
		mark.Anchored = true
		mark.CanCollide = false
		mark.CanQuery = false
		mark.CanTouch = false
		mark.Size = Vector3.new(sizeX, 0.1, sizeZ)
		mark.Position = Vector3.new(center.X, 0.06, center.Z)
		mark.Color = Color3.fromRGB(64, 10, 12)
		mark.Material = Enum.Material.Neon
		mark.Transparency = 0.92
		mark.Parent = folder

		local whisper = SoundUtil.make(mark, Config.Sounds.Whisper, {
			Volume = 0.35,
			Looped = true,
			RollOffMaxDistance = Config.Corre.WhisperRadius + 6,
			RollOffMinDistance = 2,
			Name = "Susurro",
		})
		whisper:Play()

		table.insert(activeSeals, { region = region, part = mark })
	end

	-- Vigilancia: matar a quien corra dentro de un sello.
	running = true
	task.spawn(function()
		while running do
			task.wait(0.12)
			for _, player in Players:GetPlayers() do
				local st = PlayerSession.get(player)
				if st.dead or st.safe then
					continue
				end
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if not root then
					continue
				end
				for _, seal in activeSeals do
					if map.regionContains(seal.region, root.Position) then
						local v = root.AssemblyLinearVelocity
						local speed = Vector3.new(v.X, 0, v.Z).Magnitude
						if speed &gt; Config.RunDeathSpeed then
							SoundUtil.playAt(root.Position, Config.Sounds.Snap, 1, 90)
							PlayerSession.kill(player, "corre")
						end
						break
					end
				end
			end
		end
	end)
end

function Corre.cleanup()
	running = false
	table.clear(activeSeals)
	if folder then
		folder:Destroy()
		folder = nil
	end
end

return Corre
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX11">
          <Properties>
            <string name="Name">ElViejo</string>
            <ProtectedString name="Source">--!strict
-- EL VIEJO.
-- Antes de la hora prohibida deambula por el bazar, se acerca a los jugadores,
-- pregunta la hora y advierte que no deberían estar afuera. Cuando el reloj
-- marca las 23:59 comienza la cacería: persigue a la presa más ruidosa/cercana
-- usando pathfinding, acecha frente a los refugios y mata por contacto.

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local SoundUtil = require(ReplicatedStorage.Shared.SoundUtil)
local RigFactory = require(script.Parent.Parent.RigFactory)
local PlayerSession = require(script.Parent.Parent.PlayerSession)

local ElViejo = {}
ElViejo.__index = ElViejo

local rng = Random.new()

local function makeBillboard(head: BasePart): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Name = "Dialogo"
	gui.Size = UDim2.fromOffset(340, 60)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 45
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Merriweather
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(226, 219, 200)
	label.TextStrokeTransparency = 0.4
	label.Text = ""
	label.Visible = false
	label.Parent = gui
	gui.Parent = head
	return label
end

function ElViejo.new(map: any)
	local self = setmetatable({}, ElViejo)
	self.map = map
	self.mode = "PASSIVE" -- PASSIVE | HUNT | DEAD
	self.phase = "TARDE"
	self.alive = true
	self.huntStart = 0

	local model, humanoid = RigFactory.create({
		name = "ElViejo",
		skin = Color3.fromRGB(172, 160, 148),
		shirt = Color3.fromRGB(74, 72, 68),
		pants = Color3.fromRGB(48, 46, 44),
		scale = 1.12,
		hunch = 14,
		walkSpeed = Config.Viejo.WalkSpeed,
	})
	self.model = model
	self.humanoid = humanoid
	self.root = model.PrimaryPart :: BasePart
	model:SetAttribute("Hunting", false)

	local head = model:FindFirstChild("Head") :: BasePart
	self.dialog = makeBillboard(head)
	self.breath = SoundUtil.make(self.root, Config.Sounds.Breathing, {
		Volume = 0,
		Looped = true,
		RollOffMaxDistance = 40,
		RollOffMinDistance = 4,
		Name = "Respiracion",
	})
	self.breath:Play()
	self.steps = SoundUtil.make(self.root, Config.Sounds.Snap, {
		Volume = 0.25,
		RollOffMaxDistance = 50,
		Name = "Pasos",
	})

	RigFactory.place(model, Vector3.new(map.viejoSpawn.X, 0, map.viejoSpawn.Z))
	model.Parent = workspace

	task.spawn(function()
		self:_run()
	end)
	task.spawn(function()
		self:_killLoop()
	end)
	task.spawn(function()
		self:_stepLoop()
	end)

	return self
end

function ElViejo:setPhase(phase: string)
	self.phase = phase
	if phase == "PROHIBIDA" and self.mode == "PASSIVE" then
		self.mode = "HUNT"
		self.huntStart = os.clock()
		self.model:SetAttribute("Hunting", true)
		self.breath.Volume = 0.65
		SoundUtil.playAt(self.root.Position, Config.Sounds.Scream, 0.9, 250)
		self:_say("Ya es hora.")
	end
end

function ElViejo:_say(text: string)
	self.dialog.Text = text
	self.dialog.Visible = true
	task.delay(4, function()
		if self.dialog.Text == text then
			self.dialog.Visible = false
		end
	end)
end

-- ── Utilidades de movimiento ─────────────────────────────────────────────────

function ElViejo:_computePath(target: Vector3): { PathWaypoint }?
	local path = PathfindingService:CreatePath({
		AgentRadius = 2.2,
		AgentHeight = 7,
		AgentCanJump = false,
		WaypointSpacing = 6,
	})
	local ok = pcall(function()
		path:ComputeAsync(self.root.Position, target)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		return path:GetWaypoints()
	end
	return nil
end

function ElViejo:_walkPath(target: Vector3, timeout: number, stopIf: (() -&gt; boolean)?): boolean
	local waypoints = self:_computePath(target)
	local t0 = os.clock()
	if not waypoints then
		-- Sin ruta: intenta ir directo (los pasillos son amplios).
		self.humanoid:MoveTo(target)
		while os.clock() - t0 &lt; math.min(timeout, 3) do
			task.wait(0.15)
			if not self.alive or (stopIf and stopIf()) then
				return false
			end
			if (self.root.Position - target).Magnitude &lt; 4 then
				return true
			end
		end
		return false
	end

	for i = 2, #waypoints do
		local wp = waypoints[i]
		self.humanoid:MoveTo(wp.Position)
		local reachedT0 = os.clock()
		while true do
			task.wait(0.1)
			if not self.alive or (stopIf and stopIf()) then
				return false
			end
			local flat = self.root.Position - wp.Position
			if Vector2.new(flat.X, flat.Z).Magnitude &lt; 3 then
				break
			end
			if os.clock() - reachedT0 &gt; 3 or os.clock() - t0 &gt; timeout then
				return false
			end
		end
	end
	return true
end

-- ── Comportamiento pasivo (TARDE / CIERRE) ───────────────────────────────────

function ElViejo:_approachSomeone()
	local candidates = PlayerSession.alivePlayers()
	if #candidates == 0 then
		return
	end
	local target = candidates[rng:NextInteger(1, #candidates)]
	local char = target.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	if (root.Position - self.root.Position).Magnitude &gt; 110 then
		return
	end

	self:_walkPath(root.Position, 25, function()
		return self.mode ~= "PASSIVE"
	end)
	if self.mode ~= "PASSIVE" or not root.Parent then
		return
	end

	-- Encara al jugador y suelta una de sus frases.
	local look = CFrame.lookAt(self.root.Position, Vector3.new(root.Position.X, self.root.Position.Y, root.Position.Z))
	self.model:PivotTo(look)
	local lines = Config.ViejoLines[self.phase] or Config.ViejoLines.TARDE
	self:_say(lines[rng:NextInteger(1, #lines)])
	SoundUtil.playAt(self.root.Position, Config.Sounds.Whisper, 0.5, 30)
	task.wait(4)
end

-- ── Cacería (PROHIBIDA) ──────────────────────────────────────────────────────

function ElViejo:_pickPrey(): (Player?, BasePart?)
	local best: Player? = nil
	local bestRoot: BasePart? = nil
	local bestScore = math.huge
	for _, player in PlayerSession.alivePlayers() do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			continue
		end
		if self.map.isInRefuge(root.Position) then
			continue -- dentro de un refugio no lo puede alcanzar... por ahora
		end
		local noise = (char :: Model):GetAttribute("Noise") or 0
		local score = (root.Position - self.root.Position).Magnitude - (noise :: number) * Config.Viejo.NoiseWeight
		if score &lt; bestScore then
			bestScore = score
			best = player
			bestRoot = root
		end
	end
	return best, bestRoot
end

function ElViejo:_huntSpeed(): number
	local t = math.clamp((os.clock() - self.huntStart) / Config.Viejo.HuntRampTime, 0, 1)
	return Config.Viejo.HuntSpeedStart + (Config.Viejo.HuntSpeedEnd - Config.Viejo.HuntSpeedStart) * t
end

function ElViejo:_hunt()
	self.humanoid.WalkSpeed = self:_huntSpeed()
	local prey, preyRoot = self:_pickPrey()

	if not prey or not preyRoot then
		-- Todos escondidos: acecha el refugio del jugador vivo más cercano.
		local nearest: BasePart? = nil
		local nearestDist = math.huge
		for _, player in PlayerSession.alivePlayers() do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local d = (root.Position - self.root.Position).Magnitude
				if d &lt; nearestDist then
					nearestDist = d
					nearest = root
				end
			end
		end
		if nearest then
			-- Camina hasta cerca del refugio y espera, respirando.
			local outside = nearest.Position + (self.root.Position - nearest.Position).Unit * 8
			self:_walkPath(outside, 12, function()
				return self.mode ~= "HUNT"
			end)
			self.breath.Volume = 0.9
			task.wait(Config.Viejo.LurkTime)
			self.breath.Volume = 0.65
		else
			task.wait(1)
		end
		return
	end

	-- Persecución con recálculo de ruta.
	local lastKnown = preyRoot.Position
	self:_walkPath(lastKnown, Config.Viejo.RepathInterval + 1.2, function()
		if self.mode ~= "HUNT" then
			return true
		end
		-- Si la presa se movió bastante, corta y recalcula.
		return preyRoot.Parent ~= nil and (preyRoot.Position - lastKnown).Magnitude &gt; 7
	end)
end

-- ── Bucles principales ───────────────────────────────────────────────────────

function ElViejo:_run()
	local nextApproach = os.clock() + rng:NextNumber(6, 12)
	while self.alive do
		if self.mode == "PASSIVE" then
			self.humanoid.WalkSpeed = Config.Viejo.WalkSpeed
			if os.clock() &gt;= nextApproach then
				self:_approachSomeone()
				nextApproach = os.clock() + rng:NextNumber(Config.Viejo.ApproachIntervalMin, Config.Viejo.ApproachIntervalMax)
			else
				local p = self.map.patrolPoints[rng:NextInteger(1, #self.map.patrolPoints)]
				self:_walkPath(p, 14, function()
					return self.mode ~= "PASSIVE" or os.clock() &gt;= nextApproach
				end)
			end
		elseif self.mode == "HUNT" then
			self:_hunt()
		else
			break
		end
		task.wait(0.1)
	end
end

function ElViejo:_killLoop()
	while self.alive do
		task.wait(0.12)
		if self.mode ~= "HUNT" then
			continue
		end
		for _, player in PlayerSession.alivePlayers() do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root then
				continue
			end
			if self.map.isInRefuge(root.Position) then
				continue
			end
			if (root.Position - self.root.Position).Magnitude &lt;= Config.Viejo.KillRadius then
				PlayerSession.kill(player, "viejo")
			end
		end
	end
end

-- Pasos audibles: el peligro se anuncia por el oído.
function ElViejo:_stepLoop()
	while self.alive do
		local speed = self.humanoid.WalkSpeed
		local moving = self.root.AssemblyLinearVelocity.Magnitude &gt; 1
		if moving then
			self.steps.PlaybackSpeed = self.mode == "HUNT" and 1.15 or 0.8
			self.steps.Volume = self.mode == "HUNT" and 0.5 or 0.25
			self.steps:Play()
		end
		task.wait(moving and math.clamp(6 / math.max(speed, 1), 0.28, 0.9) or 0.4)
	end
end

function ElViejo:destroy()
	self.alive = false
	self.mode = "DEAD"
	if self.model.Parent then
		self.model:Destroy()
	end
end

return ElViejo
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">Footsteps</string>
          <ProtectedString name="Source">--!strict
-- Pasos de los jugadores. El Sound vive en el personaje y lo reproduce el
-- servidor, así que todos los demás oyen por dónde anda cada quien: correr
-- se escucha desde mucho más lejos que caminar.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local SoundUtil = require(ReplicatedStorage.Shared.SoundUtil)

local Footsteps = {}

local function attach(char: Model)
	local root = char:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then
		return
	end

	local step = SoundUtil.make(root, Config.Sounds.Snap, {
		Volume = 0.3,
		RollOffMaxDistance = 45,
		RollOffMinDistance = 4,
		Name = "Paso",
	})

	task.spawn(function()
		while char.Parent and hum.Health &gt; 0 do
			local v = root.AssemblyLinearVelocity
			local speed = Vector3.new(v.X, 0, v.Z).Magnitude
			if speed &gt; 1.5 then
				local running = speed &gt; Config.WalkSpeed + 1
				step.Volume = running and 0.6 or 0.28
				step.PlaybackSpeed = running and 1.15 or 0.9
				step.RollOffMaxDistance = running and 90 or 45
				step:Play()
				-- Un paso cada ~4 studs recorridos.
				task.wait(math.clamp(4 / speed, 0.22, 0.7))
			else
				task.wait(0.2)
			end
		end
	end)
end

function Footsteps.init()
	local function hook(player: Player)
		player.CharacterAdded:Connect(attach)
		if player.Character then
			attach(player.Character)
		end
	end
	for _, player in Players:GetPlayers() do
		hook(player)
	end
	Players.PlayerAdded:Connect(hook)
end

return Footsteps
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX13">
        <Properties>
          <string name="Name">GameLoop</string>
          <ProtectedString name="Source">--!strict
-- Orquestador de la partida.
-- Bucle: INTERMISSION → TARDE → CIERRE → HORA PROHIBIDA → RESULTADOS → ...
-- Gestiona el reloj del juego, el cierre escalonado de persianas, los
-- encargos (objetivo), la detección de "llegó a casa" y el fin de ronda.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local SoundUtil = require(ReplicatedStorage.Shared.SoundUtil)

local PlayerSession = require(script.Parent.PlayerSession)
local LightingRig = require(script.Parent.LightingRig)
local NPCSystem = require(script.Parent.NPCSystem)
local ElViejo = require(script.Parent.Entities.ElViejo)
local Corre = require(script.Parent.Entities.Corre)

local GameLoop = {}

local rng = Random.new()
local map: any
local viejo: any = nil
local packagesFolder: Folder? = nil
local assignments: { [Player]: number } = {} -- jugador → índice de departamento
local roundActive = false

local ambience: Sound
local nightAmbience: Sound

-- ── Utilidades ───────────────────────────────────────────────────────────────

local function toastAll(msg: string, kind: string?)
	Remotes.get("Toast"):FireAllClients(msg, kind or "info")
end

local function formatClock(totalMinutes: number): (number, number)
	local m = math.floor(totalMinutes) % (24 * 60)
	return math.floor(m / 60), m % 60
end

-- ── Asignación de departamentos ──────────────────────────────────────────────

local function assignApartment(player: Player): number
	local used = {}
	for _, idx in assignments do
		used[idx] = true
	end
	for i = 1, #map.apartments do
		if not used[i] then
			assignments[player] = i
			return i
		end
	end
	-- Más jugadores que departamentos: comparte el último.
	assignments[player] = #map.apartments
	return #map.apartments
end

local function spawnInApartment(player: Player)
	local idx = assignments[player] or assignApartment(player)
	local apt = map.apartments[idx]
	PlayerSession.get(player).aptIndex = idx
	PlayerSession.spawnAt(player, apt.spawnCF)
end

-- ── Encargos (objetivo de la ronda) ──────────────────────────────────────────

local function placePackages(playersInRound: { Player })
	packagesFolder = Instance.new("Folder")
	packagesFolder.Name = "Encargos"
	packagesFolder.Parent = map.model

	-- Baraja los locales para repartir un encargo por jugador.
	local pool = table.clone(map.locales)
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end

	for i, player in playersInRound do
		local locale = pool[((i - 1) % #pool) + 1]

		local box = Instance.new("Part")
		box.Name = "Encargo_" .. player.Name
		box.Anchored = true
		box.Size = Vector3.new(1.8, 1.4, 1.4)
		box.Position = locale.packageSpot
		box.Color = Color3.fromRGB(168, 132, 92)
		box.Material = Enum.Material.SmoothPlastic
		box.Parent = packagesFolder

		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(160, 34)
		gui.StudsOffset = Vector3.new(0, 1.6, 0)
		gui.MaxDistance = 30
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Gotham
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(228, 214, 186)
		label.TextStrokeTransparency = 0.5
		label.Text = "Encargo de " .. player.DisplayName
		label.Parent = gui
		gui.Parent = box

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Recoger encargo"
		prompt.ObjectText = locale.name
		prompt.HoldDuration = 1
		prompt.MaxActivationDistance = 7
		prompt.RequiresLineOfSight = false
		prompt.Parent = box

		prompt.Triggered:Connect(function(who)
			if who ~= player then
				Remotes.get("Toast"):FireClient(who, "Ese encargo no es tuyo.", "info")
				return
			end
			local st = PlayerSession.get(player)
			if st.dead then
				return
			end
			st.hasPackage = true
			box:Destroy()
			Remotes.get("Toast"):FireClient(player, "Tienes tu encargo. Ahora vuelve a tu departamento.", "good")
			local apt = map.apartments[st.aptIndex or 1]
			Remotes.get("Objective"):FireClient(player, "Regresa a tu departamento (" .. apt.name .. ") antes de las 23:59.")
		end)

		local st = PlayerSession.get(player)
		st.hasPackage = false
		local apt = map.apartments[st.aptIndex or 1]
		Remotes.get("Objective"):FireClient(
			player,
			('Recoge tu encargo en "%s" y vuelve a tu departamento (%s) antes de las 23:59.'):format(locale.name, apt.name)
		)
	end
end

-- ── Detección de "llegó a casa" ──────────────────────────────────────────────

local function watchHomecoming()
	task.spawn(function()
		while roundActive do
			task.wait(0.4)
			for _, player in Players:GetPlayers() do
				local st = PlayerSession.get(player)
				if st.dead or st.safe or not st.aptIndex then
					continue
				end
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if not root then
					continue
				end
				local apt = map.apartments[st.aptIndex]
				if map.regionContains(apt.region, root.Position) then
					st.safe = true
					if st.hasPackage then
						toastAll(player.DisplayName .. " llegó a casa con su encargo.", "good")
					else
						toastAll(player.DisplayName .. " llegó a casa... sin su encargo.", "info")
					end
					Remotes.get("Objective"):FireClient(player, "Estás en casa. No salgas.")
				end
			end
		end
	end)
end

-- ── Fases y reloj ────────────────────────────────────────────────────────────

-- Ejecuta una fase: transmite el reloj cada segundo y llama onTick(elapsed).
-- Devuelve true si la fase terminó por tiempo, false si earlyEnd() la cortó.
local function runPhase(name: string, onTick: ((number) -&gt; ())?, earlyEnd: (() -&gt; boolean)?): boolean
	local duration = Config.PhaseDurations[name]
	local range = Config.ClockRanges[name]
	Remotes.get("Phase"):FireAllClients(name)

	local t0 = os.clock()
	local lastWhole = -1
	while true do
		local elapsed = os.clock() - t0
		if elapsed &gt;= duration then
			return true
		end
		if earlyEnd and earlyEnd() then
			return false
		end
		local whole = math.floor(elapsed)
		if whole &gt; lastWhole then
			lastWhole = whole
			local minutes = range[1] + (range[2] - range[1]) * (elapsed / duration)
			local hh, mm = formatClock(minutes)
			Remotes.get("Clock"):FireAllClients(hh, mm)
			if onTick then
				onTick(elapsed)
			end
		end
		task.wait(0.2)
	end
end

local function everyoneResolved(): boolean
	local players = Players:GetPlayers()
	if #players == 0 then
		return true
	end
	for _, player in players do
		local st = PlayerSession.get(player)
		if st.aptIndex and not st.dead and not st.safe then
			return false
		end
	end
	return true
end

-- ── Ronda completa ───────────────────────────────────────────────────────────

local function runRound()
	roundActive = true
	PlayerSession.resetAll()

	-- Reabre todo y reparte jugadores.
	for _, locale in map.locales do
		locale.persiana:open()
		LightingRig.localeOn(locale.fixture)
	end

	assignments = {}
	local playersInRound = Players:GetPlayers()
	for _, player in playersInRound do
		assignApartment(player)
		spawnInApartment(player)
	end

	LightingRig.setPhase("TARDE")
	NPCSystem.spawnAll()
	viejo = ElViejo.new(map)
	Corre.setup()
	placePackages(playersInRound)
	watchHomecoming()

	ambience.Volume = 0.35
	nightAmbience.Volume = 0

	Remotes.get("RoundState"):FireAllClients("ROUND")
	toastAll("La tarde cae sobre el Bazar El Centenario.", "info")

	-- ── TARDE ──
	runPhase("TARDE")

	-- ── CIERRE ──
	viejo:setPhase("CIERRE")
	NPCSystem.setPhase("CIERRE")
	LightingRig.setPhase("CIERRE")
	SoundUtil.playAt(Vector3.new(0, 8, 0), Config.Sounds.Chime, 0.8, 400)
	toastAll("«Estimados clientes: el bazar cerrará en unos minutos.»", "pa")

	-- Cierre escalonado de persianas durante la fase.
	local closeOrder = {}
	for _, locale in map.locales do
		table.insert(closeOrder, locale)
	end
	for i = #closeOrder, 2, -1 do
		local j = rng:NextInteger(1, i)
		closeOrder[i], closeOrder[j] = closeOrder[j], closeOrder[i]
	end
	local cierreDur = Config.PhaseDurations.CIERRE
	local closeTimes = {}
	for i = 1, #closeOrder do
		closeTimes[i] = 8 + (cierreDur - 25) * (i - 1) / math.max(#closeOrder - 1, 1)
	end
	local closedCount = 0

	runPhase("CIERRE", function(elapsed)
		while closedCount &lt; #closeOrder and elapsed &gt;= closeTimes[closedCount + 1] do
			closedCount += 1
			local locale = closeOrder[closedCount]
			-- Los locales con encargos pendientes cierran al final de la fase.
			local hasPendingPackage = false
			if packagesFolder then
				for _, box in packagesFolder:GetChildren() do
					if map.regionContains(locale.region, (box :: Part).Position) then
						hasPendingPackage = true
						break
					end
				end
			end
			if hasPendingPackage and elapsed &lt; cierreDur - 30 then
				table.insert(closeOrder, locale) -- reintenta al final
				table.insert(closeTimes, math.max(elapsed + 20, cierreDur - 20))
			else
				locale.persiana:close()
				LightingRig.localeOff(locale.fixture)
			end
		end
	end)

	-- ── HORA PROHIBIDA ──
	ambience.Volume = 0.05
	nightAmbience.Volume = 0.5
	LightingRig.setPhase("PROHIBIDA")
	NPCSystem.setPhase("PROHIBIDA")
	viejo:setPhase("PROHIBIDA")
	for _, locale in map.locales do
		if not locale.persiana.closed then
			locale.persiana:close()
			LightingRig.localeOff(locale.fixture)
		end
	end
	toastAll("23:59. No deberías estar afuera.", "danger")
	Remotes.get("Subtitle"):FireAllClients("Algo cambió en el aire.")

	local timedOut = runPhase("PROHIBIDA", nil, everyoneResolved)

	-- A quien siga afuera cuando termina la noche, la noche lo reclama.
	if timedOut then
		for _, player in Players:GetPlayers() do
			local st = PlayerSession.get(player)
			if st.aptIndex and not st.dead and not st.safe then
				PlayerSession.kill(player, "noche")
			end
		end
	end

	-- ── RESULTADOS ──
	roundActive = false
	Remotes.get("RoundState"):FireAllClients("RESULTS")

	local survivors, fullWins, deaths = 0, 0, 0
	for _, player in Players:GetPlayers() do
		local st = PlayerSession.get(player)
		if st.aptIndex then
			if st.safe then
				survivors += 1
				if st.hasPackage then
					fullWins += 1
				end
			else
				deaths += 1
			end
		end
	end
	if survivors == 0 then
		toastAll("Nadie volvió a casa esta noche.", "danger")
	elseif deaths == 0 and fullWins == survivors then
		toastAll("Todos volvieron a casa con su encargo. Esta vez.", "good")
	else
		toastAll(("Sobrevivieron %d. El bazar se quedó con %d."):format(survivors, deaths), "info")
	end

	task.wait(8)

	-- Limpieza.
	if viejo then
		viejo:destroy()
		viejo = nil
	end
	Corre.cleanup()
	NPCSystem.cleanup()
	if packagesFolder then
		packagesFolder:Destroy()
		packagesFolder = nil
	end
end

-- ── Bucle exterior ───────────────────────────────────────────────────────────

function GameLoop.start(builtMap: any)
	map = builtMap

	-- Ambiente global (los Sound directamente en Workspace suenan para todos).
	ambience = SoundUtil.make(workspace, Config.Sounds.MallAmbience, { Volume = 0.35, Looped = true, Name = "AmbienteBazar" })
	ambience:Play()
	nightAmbience = SoundUtil.make(workspace, Config.Sounds.NightAmbience, { Volume = 0, Looped = true, Name = "AmbienteNoche" })
	nightAmbience:Play()

	-- Quien entra a mitad de ronda espera como observador.
	Players.PlayerAdded:Connect(function(player)
		if roundActive then
			Remotes.get("Toast"):FireClient(player, "La ronda ya comenzó. Observa hasta la siguiente.", "info")
			Remotes.get("RoundState"):FireClient(player, "SPECTATE")
		else
			assignApartment(player)
			spawnInApartment(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		assignments[player] = nil
	end)

	task.spawn(function()
		while true do
			-- Intermedio: espera jugadores y reparte departamentos.
			Remotes.get("RoundState"):FireAllClients("INTERMISSION")
			Remotes.get("Phase"):FireAllClients("INTERMISSION")
			Remotes.get("Clock"):FireAllClients(17, 45)

			while #Players:GetPlayers() &lt; Config.MinPlayers do
				task.wait(1)
			end

			-- Asegura que todos tengan personaje y departamento.
			for _, player in Players:GetPlayers() do
				if not player.Character then
					assignApartment(player)
					spawnInApartment(player)
				end
			end

			for t = Config.IntermissionTime, 1, -1 do
				if t == Config.IntermissionTime or t == 10 or t &lt;= 5 then
					toastAll(("La ronda comienza en %d..."):format(t), "info")
				end
				task.wait(1)
			end

			local ok, err = pcall(runRound)
			if not ok then
				warn("[LaHoraDelMercado] Error en la ronda: " .. tostring(err))
				roundActive = false
			end
		end
	end)
end

return GameLoop
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX14">
        <Properties>
          <string name="Name">LightingRig</string>
          <ProtectedString name="Source">--!strict
-- Controla la atmósfera global y las luminarias del complejo según la fase:
-- TARDE (todo encendido, cálido) → CIERRE (parcial, parpadeos) →
-- PROHIBIDA (mínimo, frío, oscuridad).

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local SoundUtil = require(ReplicatedStorage.Shared.SoundUtil)

local LightingRig = {}

local map: any
local cc: ColorCorrectionEffect
local rng = Random.new()
local flickerSet: { any } = {}
local flickerRunning = false
local currentPhase = "TARDE"

local PHASE_LIGHTING = {
	TARDE = {
		Ambient = Color3.fromRGB(34, 34, 38),
		Brightness = 1.4,
		cc = { Saturation = -0.05, Contrast = 0.02, Brightness = 0, TintColor = Color3.fromRGB(255, 252, 245) },
	},
	CIERRE = {
		Ambient = Color3.fromRGB(22, 22, 27),
		Brightness = 1.1,
		cc = { Saturation = -0.16, Contrast = 0.05, Brightness = -0.02, TintColor = Color3.fromRGB(244, 244, 248) },
	},
	PROHIBIDA = {
		Ambient = Color3.fromRGB(8, 8, 12),
		Brightness = 0.7,
		cc = { Saturation = -0.38, Contrast = 0.1, Brightness = -0.05, TintColor = Color3.fromRGB(210, 220, 248) },
	},
}

local COLD = Color3.fromRGB(198, 214, 255)

local function setFixture(f: any, on: boolean, color: Color3?, brightness: number?)
	local c = color or f.baseColor
	if on then
		f.tube.Material = Enum.Material.Neon
		f.tube.Color = c
		f.light.Enabled = true
		f.light.Color = c
		f.light.Brightness = brightness or f.baseBrightness
	else
		f.tube.Material = Enum.Material.SmoothPlastic
		f.tube.Color = Color3.fromRGB(70, 70, 74)
		f.light.Enabled = false
	end
end

local function startFlickerLoop()
	if flickerRunning then
		return
	end
	flickerRunning = true
	task.spawn(function()
		while true do
			task.wait(rng:NextNumber(1.5, 5))
			if #flickerSet == 0 then
				continue
			end
			local f = flickerSet[rng:NextInteger(1, #flickerSet)]
			if not f.tube.Parent then
				continue
			end
			SoundUtil.playAt(f.tube.Position, Config.Sounds.Buzz, 0.35, 30)
			local wasOn = f.light.Enabled
			for _ = 1, rng:NextInteger(2, 6) do
				setFixture(f, false)
				task.wait(rng:NextNumber(0.04, 0.12))
				setFixture(f, true, currentPhase == "PROHIBIDA" and COLD or nil, currentPhase == "PROHIBIDA" and 0.6 or nil)
				task.wait(rng:NextNumber(0.05, 0.15))
			end
			if not wasOn then
				setFixture(f, false)
			end
		end
	end)
end

function LightingRig.init(builtMap: any)
	map = builtMap

	-- Base de la atmósfera. Se define aquí (y no solo en el archivo de lugar)
	-- para que el juego se vea igual sin importar cómo se haya instalado.
	-- `Lighting.Technology` es la única propiedad que debe fijarse en Studio.
	Lighting.ClockTime = 0
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.2
	Lighting.EnvironmentSpecularScale = 0.35
	Lighting.ExposureCompensation = 0
	Lighting.OutdoorAmbient = Color3.fromRGB(8, 8, 13)
	Lighting.FogColor = Color3.fromRGB(6, 6, 8)
	Lighting.FogStart = 60
	Lighting.FogEnd = 420
	Lighting.ShadowSoftness = 0.25

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0
	atmosphere.Color = Color3.fromRGB(180, 180, 190)
	atmosphere.Decay = Color3.fromRGB(60, 60, 70)
	atmosphere.Haze = 1
	atmosphere.Parent = Lighting

	cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "LHM_CC"
	cc.Parent = Lighting

	startFlickerLoop()
	LightingRig.setPhase("TARDE")
end

function LightingRig.setPhase(phase: string)
	currentPhase = phase
	local def = PHASE_LIGHTING[phase]
	if not def then
		return
	end

	TweenService:Create(Lighting, TweenInfo.new(3), {
		Ambient = def.Ambient,
		Brightness = def.Brightness,
	}):Play()
	TweenService:Create(cc, TweenInfo.new(3), def.cc):Play()

	table.clear(flickerSet)

	if phase == "TARDE" then
		for _, f in map.fixtures do
			setFixture(f, true)
		end
	elseif phase == "CIERRE" then
		for i, f in map.fixtures do
			if f.zone == "apt" or f.zone == "service" then
				setFixture(f, true)
			elseif f.zone == "locale" then
				-- Las apaga el cierre de cada persiana (GameLoop).
			else
				if rng:NextNumber() &lt; 0.3 then
					setFixture(f, false)
				else
					setFixture(f, true)
					if rng:NextNumber() &lt; 0.25 then
						table.insert(flickerSet, f)
					end
				end
			end
		end
	elseif phase == "PROHIBIDA" then
		local count = 0
		for _, f in map.fixtures do
			if f.zone == "apt" then
				setFixture(f, true) -- los departamentos siguen siendo hogar
			elseif f.zone == "locale" then
				setFixture(f, false)
			elseif f.zone == "service" then
				setFixture(f, true, Color3.fromRGB(190, 240, 190), 0.5)
			else
				count += 1
				if count % 3 == 0 then
					setFixture(f, true, COLD, 0.6)
					if rng:NextNumber() &lt; 0.5 then
						table.insert(flickerSet, f)
					end
				else
					setFixture(f, false)
				end
			end
		end
	end
end

-- Apaga la luminaria de un local (cuando baja su persiana).
function LightingRig.localeOff(fixture: any)
	setFixture(fixture, false)
end

function LightingRig.localeOn(fixture: any)
	setFixture(fixture, true)
end

return LightingRig
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX15">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">--!strict
-- Punto de entrada del servidor de "La Hora del Mercado".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
